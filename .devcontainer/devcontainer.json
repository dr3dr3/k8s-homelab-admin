{
    "name": "DR3-CLI-TOOLS",

    "build": {
        "dockerfile": "Dockerfile"
    },

    "workspaceFolder": "/workspace",

    "mounts": [ "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind" ],

    "postCreateCommand": "gum style --foreground 003 --border-foreground 003 --border rounded --align center --width 50 --margin '1 2' --padding '2 4' 'K8S Homelab Admin' 'Dev Container'",

    "postStartCommand": "cd ~/.dotfiles && stow .",

    "customizations": {
        "vscode": {
            "extensions": [
                "github.vscode-pull-request-github",
                "github.copilot",
                "redhat.vscode-yaml",
                "ms-kubernetes-tools.vscode-kubernetes-tools",
                "1Password.op-vscode"
            ]
        }
    },

    "forwardPorts": [
        8080
    ]

}
